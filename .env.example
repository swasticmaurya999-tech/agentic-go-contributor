# Copy this file to .env and fill in the key for the provider you want to use.
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# .env is gitignored and never committed.

# Which LLM provider to use: groq | gemini | openai | anthropic
LLM_PROVIDER=groq

# Optional: override the model. Leave blank to use the provider's default.
#   groq      -> openai/gpt-oss-120b   (free)
#   gemini    -> gemini-2.5-flash      (free)
#   openai    -> gpt-4o                (paid)
#   anthropic -> claude-3-5-sonnet-latest (paid)
LLM_MODEL=

# --- API keys: set ONLY the one for your chosen provider ---
GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- GitHub (optional, only needed for the --open-pr feature) ---
# GH_TOKEN=
